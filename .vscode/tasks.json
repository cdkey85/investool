{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "create-dist-folder",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (!(Test-Path '${workspaceFolder}/dist')) { New-Item -ItemType Directory -Path '${workspaceFolder}/dist' }"
            ],
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
